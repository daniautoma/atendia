{
  "name": "atendia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:db": "node scripts/db-server.mjs",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --outfile=dist/worker.cjs --external:@prisma/client --external:@whiskeysockets/baileys --external:jimp --external:pino --external:bcryptjs",
    "start": "next start",
    "start:worker": "node dist/worker.cjs",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "jimp": "^1.6.1",
    "jose": "^6.2.14",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@esbuild/linux-musl-x64": "^0.28.0",
    "@esbuild/linux-x64": "^0.28.0"
  }
}
