datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
}

enum ChannelType {
  WHATSAPP
  WEB
}

enum WhatsAppProvider {
  BAILEYS
  YCLOUD
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  WAITING_QR
  CONNECTED
  ERROR
}

enum ConversationStatus {
  BOT_ACTIVE
  WAITING_HUMAN
  RESOLVED
}

enum MessageSender {
  CUSTOMER
  ASSISTANT
  AGENT
  SYSTEM
}

enum LogStatus {
  SUCCESS
  WARNING
  ERROR
  INFO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(AGENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessProfile {
  id              String   @id @default(cuid())
  name            String   @default("danIAutoma")
  activity        String   @default("Agencia de Automatización con IA, Agentes de WhatsApp y Desarrollo Web")
  address         String   @default("San Salvador, El Salvador (Atención Digital y Consultoría Remota)")
  phone           String   @default("+503 7000 0000")
  website         String   @default("https://daniautoma.com")
  timezone        String   @default("America/El_Salvador")
  assistantActive Boolean  @default(true)
  agencyName      String   @default("danIAutoma")
  agencyLogo      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AssistantConfig {
  id                   String   @id @default(cuid())
  name                 String   @default("Asistente danIAutoma")
  avatarUrl            String?
  tone                 String   @default("cercano") // cercano, profesional, directo
  welcomeMessage       String   @default("¡Hola! 👋 Soy el asistente virtual de danIAutoma. ¿Te gustaría conocer cómo automatizar la atención y citas de tu negocio con IA o agendar una llamada de diagnóstico gratuito?")
  customInstructions   String   @default("Sé cercano, consultivo, claro y orientado a ayudar a dueños de negocios locales (clínicas, talleres, academias, inmobiliarias, comercios) a no perder clientes por tardar en responder. Trata al cliente o prospecto con cordialidad y tuteo respetuoso. Tu objetivo principal es resolver dudas y agendar una Llamada de Diagnóstico Gratuito (30 min).")
  neverDoList          String   @default("No inventar servicios o precios que no estén en el catálogo oficial. No garantizar resultados sin un diagnóstico previo. No confirmar citas fuera del horario disponible ni los domingos.")
  businessHours        Json     // Horario L-D
  outsideHoursBehavior String   @default("APPOINTMENT_OR_MESSAGE") // APPOINTMENT_OR_MESSAGE o ONLY_MESSAGE
  handoffRules         Json     // { onComplaint: true, onUrgency: true, onHumanRequest: true, onUnknownAnswer: true, customRule: "" }
  aiModel              String   @default("openai/gpt-4o-mini")
  aiModelFallback      String   @default("openai/gpt-4o-mini")
  systemPromptOverride String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Service {
  id                  String   @id @default(cuid())
  name                String
  description         String
  durationMinutes     Int      @default(30)
  price               Float?
  isPriceFrom         Boolean  @default(false)
  requiresEvaluation Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChannelConfig {
  id                 String           @id @default(cuid())
  type               ChannelType      @unique
  // WhatsApp settings
  waProvider         WhatsAppProvider @default(BAILEYS)
  waStatus           ConnectionStatus @default(DISCONNECTED)
  waPhoneNumber      String?
  waBusinessName     String?
  // Baileys state
  baileysQrCode      String?          @db.Text
  baileysSessionDir  String           @default("./whatsapp-session")
  // YCloud encrypted credentials & settings
  ycloudApiKeyEnc    String?          // Cifrado AES-256-GCM
  ycloudWebhookSecretEnc String?      // Cifrado AES-256-GCM
  ycloudWabaId       String?
  ycloudPhoneNumberId String?
  // Web Chat settings
  webChatEnabled     Boolean          @default(true)
  webChatColor       String           @default("#0f766e")
  webChatTitle       String           @default("Chat de Atención")
  webChatWelcome     String           @default("¿Tienes alguna consulta o quieres pedir cita? Escríbenos.")
  updatedAt          DateTime         @updatedAt
}

model Integration {
  id            String   @id @default(cuid())
  provider      String   @unique // "google_calendar", "gmail", "google_sheets", "slack", "stripe", "webhooks"
  name          String
  enabled       Boolean  @default(false)
  credentialsEnc String?  // JSON cifrado con tokens, apiKeys o secrets
  config        Json?    // Opciones y casillas de permisos del asistente
  lastSyncAt    DateTime?
  updatedAt     DateTime @updatedAt
}

model Contact {
  id                String         @id @default(cuid())
  name              String?
  phone             String?        @unique
  email             String?
  // Identificadores de proveedores
  waLid             String?        // WhatsApp Linked Device / Baileys LID
  ycloudBsuid       String?        // YCloud / Meta Business-Scoped User ID
  webSessionId      String?
  notes             String?
  conversations     Conversation[]
  appointments      Appointment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Conversation {
  id               String             @id @default(cuid())
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          ChannelType
  waProvider       WhatsAppProvider?
  status           ConversationStatus @default(BOT_ACTIVE)
  lastMessageAt    DateTime           @default(now())
  unreadCount      Int                @default(0)
  needsHumanReason String?
  messages         Message[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, lastMessageAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  senderName     String?       // Nombre del agente humano o emisor para trazabilidad
  text           String
  toolCalls      Json?         // Registro de tools invocadas para este mensaje
  externalId     String?       // ID del mensaje en Baileys o YCloud (para idempotencia)
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

model Appointment {
  id               String   @id @default(cuid())
  contactId        String
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  serviceName      String
  startTime        DateTime
  endTime          DateTime
  status           String   @default("CONFIRMED") // CONFIRMED, CANCELLED, RESCHEDULED
  googleCalendarEventId String?
  reminderSent     Boolean  @default(false)
  paymentLinkId    String?
  paymentStatus    String?  // PENDING, PAID
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ActivityLog {
  id          String    @id @default(cuid())
  action      String    // ej: "ai.response", "gcal.create_event", "ycloud.webhook", "handoff.triggered"
  channel     ChannelType?
  details     Json?
  status      LogStatus @default(INFO)
  error       String?
  createdAt   DateTime  @default(now())

  @@index([action, createdAt])
}

model WorkerJob {
  id        String   @id @default(cuid())
  type      String   // "PROCESS_INBOUND", "SEND_WHATSAPP", "SEND_REMINDER", "DAILY_SUMMARY"
  payload   Json
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts  Int      @default(0)
  error     String?
  scheduledFor DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
}

// ==============================================================================
// MÓDULO PRIVADO HQ — CUARTEL GENERAL DANIAUTOMA
// ==============================================================================

enum HqLeadStatus {
  NEW
  ANALYZED
  CONTACTED
  REPLIED
  MEETING
  WON
  LOST
}

enum HqTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum HqTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model HqLead {
  id               String        @id @default(cuid())
  name             String
  niche            String
  contactInfo      String
  status           HqLeadStatus  @default(NEW)
  value            Float?
  notes            String?       @db.Text
  
  // Campos de Radar de Clientes
  placeId          String?       @unique
  formattedAddress String?
  latitude         Float?
  longitude        Float?
  phone            String?
  websiteUri       String?
  hasOwnWebsite    Boolean       @default(false)
  platformType     String?       // 'none' | 'owned' | 'social' | 'directory' | 'linkhub'
  businessStatus   String?       // 'OPERATIONAL' | 'CLOSED_TEMPORARILY' | 'CLOSED_PERMANENTLY'
  rating           Float?
  userRatingCount  Int?
  category         String?
  googleMapsUri    String?
  nextActionDate   DateTime?
  
  // Auditoría y scoring
  provisionalScore Int?
  finalScore       Int?
  scoreBreakdown   Json?         // Desglose de puntos de oportunidad
  pageSpeedAudit   Json?         // Métricas Lighthouse + base64 screenshot
  aiAnalysis       Json?         // Análisis estructurado de Gemini
  pitches          Json?         // WhatsApp, llamadas 30s, correo generados
  
  tasks            HqTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([placeId])
}

model HqTask {
  id            String         @id @default(cuid())
  title         String
  description   String?        @db.Text
  status        HqTaskStatus   @default(TODO)
  priority      HqTaskPriority @default(MEDIUM)
  isAiGenerated Boolean        @default(false)
  leadId        String?
  lead          HqLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, priority])
}

model HqWeeklyGoal {
  id            String    @id @default(cuid())
  visionText    String    @db.Text
  aiFeedback    String?   @db.Text
  weekStartDate DateTime
  weekEndDate   DateTime
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([weekStartDate, weekEndDate])
}

model HqRadarSearchCache {
  id            String   @id @default(cuid())
  cacheKey      String   @unique // Ej: "san_salvador:dentistas"
  zone          String
  niche         String
  results       Json     // Array de negocios encontrados
  nextPageToken String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime // TTL 48h

  @@index([cacheKey, expiresAt])
}

model HqRadarUsage {
  id            String   @id @default(cuid())
  monthYear     String   @unique // Ej: "2026-11"
  placesCalls   Int      @default(0)
  limitAlert    Int      @default(800)
  updatedAt     DateTime @updatedAt
}

model HqRadarSettings {
  id                 String   @id @default("default")
  sellerName         String   @default("Daniel")
  agencyName         String   @default("danIAutoma")
  servicesOffered    Json?    // Lista editable de servicios de la agencia
  valueProposition   String   @db.Text @default("Ayudamos a negocios en El Salvador a captar y agendar más clientes 24/7 con agentes de IA en WhatsApp, sitios web modernos y automatización.")
  defaultTone        String   @default("cercano")
  placesMonthlyLimit Int      @default(800)
  updatedAt          DateTime @updatedAt
}


